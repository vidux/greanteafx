# Origin allowed to call this service (the frontend).
GREANTEAFX_CORS_ORIGIN=http://localhost:3000

# Where uploaded samples are cached. Defaults to ./.data/assets
# GREANTEAFX_ASSET_DIR=./.data/assets

# How long an uploaded sample stays available, in ms. Default 6 hours.
# GREANTEAFX_ASSET_TTL_MS=21600000

# Upload size ceiling in bytes. Default 64 MB.
# GREANTEAFX_MAX_UPLOAD_BYTES=67108864

# Resolution of the stored waveform envelope (min/max pairs). Default 2048.
# GREANTEAFX_PEAK_BUCKETS=2048

# Decodes and renders allowed to run at once, shared by all users. Default 1; the native audio
# library is not safe to run two jobs at once in one process. Scale with more processes instead.
# GREANTEAFX_MAX_CONCURRENT_JOBS=1

# Jobs allowed to wait for a slot; beyond this, requests get 503 and retry. Default 16.
# GREANTEAFX_MAX_QUEUED_JOBS=16
